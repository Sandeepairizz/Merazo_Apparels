---
// NewsletterFooter.astro — Part A-7, Part E-09 & E-10
// Compact layout, high contrast AA text,
// 6-image mosaic with alternating parallax,
// giant MERAZO® wordmark rising with drawn red underline, mono copyright.
import MagneticButton from './islands/MagneticButton';
---

<!-- Newsletter Section -->
<section class="newsletter section" id="newsletter" aria-label="Newsletter subscription">
  <div class="container">

    <div class="section-header">
      <p class="text-mono" style="color:var(--muted-dark);margin-bottom:1.5rem;">08 / 08 · DISPATCHES</p>
      <div data-reveal-heading>
        <h1 class="newsletter__h2 display-grotesk">
          <span class="mask" style="display:block;"><span class="mask-inner">STAY IN</span></span>
          <span class="mask" style="display:block;"><span class="mask-inner text-accent">THE CUT.</span></span>
        </h1>
      </div>
    </div>

    <p style="margin-top:1.25rem;font-size:1rem;color:rgba(255,255,255,0.75);max-width:44ch;line-height:1.6;">
      Private edition drops, fabric technical bulletins, and atelier invitations. Zero spam.
    </p>

    <!-- Email Form with Underline Input & Magnetic Button -->
    <form class="newsletter__form" action="#" method="post" aria-label="Subscribe to Merazo updates">
      <label for="newsletter-email" class="sr-only">Your email address</label>
      <input
        type="email"
        id="newsletter-email"
        name="email"
        class="newsletter__input"
        placeholder="Enter your email address"
        required
        autocomplete="email"
      />
      <MagneticButton
        variant="ghost"
        ariaLabel="Submit newsletter subscription"
        client:idle
      >
        <span style="color:var(--white);">Subscribe</span>
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 10h14M10 3l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </MagneticButton>
    </form>

    <!-- 6-Image Mosaic with Alternating Parallax (Same Grade) -->
    <div class="newsletter__mosaic" aria-hidden="true">
      {[
        { src: '/images/mosaic/01.webp', avif: '/images/mosaic/01.avif', dir: -1 },
        { src: '/images/mosaic/02.webp', avif: '/images/mosaic/02.avif', dir:  1 },
        { src: '/images/mosaic/03.webp', avif: '/images/mosaic/03.avif', dir: -1 },
        { src: '/images/mosaic/04.webp', avif: '/images/mosaic/04.avif', dir:  1 },
        { src: '/images/mosaic/05.webp', avif: '/images/mosaic/05.avif', dir: -1 },
        { src: '/images/mosaic/06.webp', avif: '/images/mosaic/06.avif', dir:  1 },
      ].map((item) => (
        <div class="mosaic-col" data-parallax={item.dir * 10}>
          <picture>
            <source srcset={item.avif} type="image/avif" />
            <source srcset={item.src} type="image/webp" />
            <img
              src={item.src}
              alt=""
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- Footer -->
<footer id="contact" role="contentinfo" aria-label="Site footer">
  <div class="container">

    <!-- Compact Footer Navigation Grid -->
    <div class="footer__grid">
      <div>
        <p class="footer__col-label">Collections</p>
        <a href="#showcase" class="footer__col-link">Oxford Cloth</a>
        <a href="#showcase" class="footer__col-link">Pure Flax Linen</a>
        <a href="#showcase" class="footer__col-link">High-Density Poplin</a>
        <a href="#showcase" class="footer__col-link">Combed Twill Overshirt</a>
        <a href="#showcase" class="footer__col-link">Silk-Cotton Satin</a>
      </div>
      <div>
        <p class="footer__col-label">House</p>
        <a href="#manifesto" class="footer__col-link">The Manifesto</a>
        <a href="#craft" class="footer__col-link">Craft by Design</a>
        <a href="#press" class="footer__col-link">Critical Acclaim</a>
        <a href="#newsletter" class="footer__col-link">Private Dispatches</a>
      </div>
      <div>
        <p class="footer__col-label">Client Care</p>
        <a href="#collection" class="footer__col-link">Bespoke Fit Consultation</a>
        <a href="#collection" class="footer__col-link">Care & Longevity Guide</a>
        <a href="#collection" class="footer__col-link">Complimentary Alterations</a>
        <a href="#collection" class="footer__col-link">Lifetime Stitch Repair</a>
      </div>
      <div>
        <p class="footer__col-label">Connect</p>
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="footer__col-link">Instagram</a>
        <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="footer__col-link">Twitter / X</a>
        <a href="mailto:hello@merazo.com" class="footer__col-link">hello@merazo.com</a>
        <a href="tel:+442079460000" class="footer__col-link">+44 (0) 20 7946 0000</a>
      </div>
    </div>

    <!-- Mono Copyright Row -->
    <div class="footer__copyright">
      <p>© {new Date().getFullYear()} MERAZO HOUSE OF SHIRTS LTD. ALL RIGHTS RESERVED. · Powered by <a href="https://airizz.co" target="_blank" rel="noopener noreferrer" style="color:var(--accent);text-decoration:underline;">AIRIZZ</a></p>
      <p style="color:var(--muted-dark);font-size:11px;">CUT WITH INTENT. WORN FOR YEARS.</p>
    </div>

  </div>
</footer>
