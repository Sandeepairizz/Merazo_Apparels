---
// src/components/TrendingSection.astro
// Positioned above Testimonials — 2-row grid of trending curated pieces with category tabs
// Reference: media_1793685354422_6743e3e9.jpg

interface TrendingProduct {
  id: string;
  name: string;
  price: string;
  category: string; // 'shirts' | 'jackets' | 'jeans' | 'sweaters' | 't-shirts' | 'trousers' | 'polos'
  image: string;
  colors: string[];
}

const categories = [
  { key: 'all', label: 'ALL' },
  { key: 'shirts', label: 'SHIRTS' },
  { key: 'jackets', label: 'JACKETS' },
  { key: 'jeans', label: 'JEANS' },
  { key: 'sweaters', label: 'SWEATERS' },
  { key: 't-shirts', label: 'T-SHIRTS' },
  { key: 'trousers', label: 'TROUSERS' },
  { key: 'shoes', label: 'SHOES' },
  { key: 'hoodies', label: 'HOODIES' },
];

const trendingProducts: TrendingProduct[] = [
  // Row 1
  {
    id: 'tr-1',
    name: 'Regular Fit Cable Knit Sweater',
    price: '₹1999',
    category: 'sweaters',
    image: '/images/products/men-01.webp',
    colors: ['#2A2520', '#C4A882', '#FAF9F5'],
  },
  {
    id: 'tr-2',
    name: '100% Cotton Mandarin Jacquard Shirt',
    price: '₹1499',
    category: 'shirts',
    image: '/images/products/men-02.webp',
    colors: ['#141414', '#FAF9F5', '#637060'],
  },
  {
    id: 'tr-3',
    name: 'Double Pocket Textured Zipper Jacket',
    price: '₹2624',
    category: 'jackets',
    image: '/images/products/men-04.webp',
    colors: ['#3D463B', '#1E221D', '#FAF9F5'],
  },
  {
    id: 'tr-4',
    name: 'Vintage Washed Selvedge Denim Trouser',
    price: '₹1999',
    category: 'jeans',
    image: '/images/categories/relaxed.webp',
    colors: ['#4A5B73', '#2C3540'],
  },
  {
    id: 'tr-5',
    name: 'Heavyweight Pima Cotton Boxy Tee',
    price: '₹1299',
    category: 't-shirts',
    image: '/images/mosaic/03.webp',
    colors: ['#FAF9F5', '#141414', '#B8AEA2'],
  },

  // Row 2
  {
    id: 'tr-6',
    name: 'Structured Wool Blend Overshirt',
    price: '₹2499',
    category: 'jackets',
    image: '/images/products/women-04.webp',
    colors: ['#637060', '#141414'],
  },
  {
    id: 'tr-7',
    name: 'Merino Ribbed Quarter-Zip Knit',
    price: '₹2199',
    category: 'sweaters',
    image: '/images/mosaic/04.webp',
    colors: ['#2A2520', '#FAF9F5'],
  },
  {
    id: 'tr-8',
    name: 'Pleated Tailored Wide-Leg Trouser',
    price: '₹2299',
    category: 'trousers',
    image: '/images/products/men-03.webp',
    colors: ['#141414', '#3B3630'],
  },
  {
    id: 'tr-9',
    name: 'High-Density Poplin Evening Shirt',
    price: '₹1999',
    category: 'shirts',
    image: '/images/products/women-01.webp',
    colors: ['#FAF9F5', '#141414'],
  },
  {
    id: 'tr-10',
    name: 'Fine Gauge Knit Silk-Cotton Polo',
    price: '₹1799',
    category: 'polos',
    image: '/images/mosaic/06.webp',
    colors: ['#3A242B', '#141414', '#FAF9F5'],
