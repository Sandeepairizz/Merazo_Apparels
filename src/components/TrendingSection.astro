---

<section class="trending section" id="trending" aria-label="Trending collection">
  <div class="container">

    <!-- Header & Category Filter Tabs -->
    <div class="trending__header">
      <p class="text-mono" style="font-size:0.75rem;letter-spacing:0.12em;color:var(--muted);margin-bottom:0.75rem;">
        02 / 08 · BEST SELLERS
      </p>
      <h1 class="trending__title display-grotesk">TRENDING</h1>

      <!-- Category Filter Pills matching reference -->
      <nav class="trending__tabs" role="tablist" aria-label="Filter trending apparel">
        {categories.map((cat, idx) => (
          <button
            class={`trending__tab ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.key}
            role="tab"
            aria-selected={idx === 0}
            type="button"
          >
            <span>{cat.label}</span>
          </button>
        ))}
      </nav>
    </div>

    <!-- 2-Row Product Cards Grid (5 across on desktop, 2 on mobile) -->
    <div class="trending__grid" role="region" aria-label="Trending pieces grid">
      {trendingProducts.map((p) => (
        <article class="trending-card" data-category={p.category}>

          <!-- Card Media Container -->
          <div class="trending-card__media">
            <button
              class="trending-card__wishlist"
              aria-label={`Add ${p.name} to wishlist`}
              type="button"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="wishlist-icon" aria-hidden="true">
                <path
                  d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <img
              src={p.image}
              alt={p.name}
              class="trending-card__img"
              width="600"
              height="800"
              loading="lazy"
              decoding="async"
            />
          </div>

          <!-- Card Content Info -->
          <div class="trending-card__info">
            <div class="trending-card__title-row">
              <h3 class="trending-card__name">{p.name}</h3>
              <button
                class="trending-card__add"
                aria-label={`Quick add ${p.name} to bag`}
                type="button"
                title="Add to bag"
              >
                +
              </button>
            </div>

            <p class="trending-card__price">{p.price}</p>

            <!-- Color Swatches -->
            <div class="trending-card__swatches" aria-hidden="true">
              {p.colors.map((c) => (
                <span class="trending-card__swatch" style={`background-color: ${c};`}></span>
              ))}
              <span class="trending-card__swatch-more text-mono">+1</span>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<script>
  // Filter tabs behavior
  function initTrendingTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.trending__tab');
    const cards = document.querySelectorAll<HTMLElement>('.trending-card');
    const wishlistBtns = document.querySelectorAll<HTMLButtonElement>('.trending-card__wishlist');
    const addBtns = document.querySelectorAll<HTMLButtonElement>('.trending-card__add');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.dataset.filter || 'all';

        cards.forEach((card) => {
          const category = card.dataset.category || '';
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
            card.style.opacity = '1';
          } else {
            card.style.display = 'none';
            card.style.opacity = '0';
          }
        });
      });
    });

    // Wishlist toggle
    wishlistBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        btn.classList.toggle('active');
        const icon = btn.querySelector('.wishlist-icon path');
        if (btn.classList.contains('active')) {
          icon?.setAttribute('fill', '#E10600');
          icon?.setAttribute('stroke', '#E10600');
        } else {
          icon?.setAttribute('fill', 'none');
          icon?.setAttribute('stroke', 'currentColor');
        }
      });
    });

    // Quick add feedback
    addBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        btn.textContent = '✓';
        btn.style.color = '#E10600';
        setTimeout(() => {
          btn.textContent = '+';
          btn.style.color = '';
        }, 1200);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initTrendingTabs);
</script>

<style>
  .trending {
    background-color: var(--white, #FFFFFF);
    padding-top: clamp(4.5rem, 8vw, 8rem);
    padding-bottom: clamp(4.5rem, 8vw, 8rem);
    border-top: 1px solid rgba(10, 10, 10, 0.08);
    position: relative;
  }

  .trending__header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .trending__title {
    font-family: var(--font-grotesk, "Inter Tight", "Helvetica Neue", Arial, sans-serif);
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.85;
    font-kerning: normal;
    text-transform: uppercase;
    color: var(--ink, #0A0A0A);
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Filter Tabs */
  .trending__tabs {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    border-bottom: 1px solid rgba(10, 10, 10, 0.12);
    padding-bottom: 0.75rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .trending__tabs::-webkit-scrollbar {
    display: none;
  }

  .trending__tab {
    background: none;
    border: none;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted, #6B6B6B);
    cursor: pointer;
    position: relative;
    padding-bottom: 0.75rem;
    margin-bottom: -0.75rem;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .trending__tab:hover {
    color: var(--ink, #0A0A0A);
  }

  .trending__tab.active {
    color: var(--ink, #0A0A0A);
    font-weight: 700;
  }

  .trending__tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--ink, #0A0A0A);
  }

  /* 2-Row Grid */
  .trending__grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    margin-top: clamp(2rem, 3.5vw, 3rem);
  }

  .trending-card {
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s ease;
  }

  .trending-card:hover {
    transform: translateY(-4px);
  }

  .trending-card__media {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    background: var(--off-white, #F6F5F2);
    overflow: hidden;
    border-radius: 2px;
  }

  .trending-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .trending-card:hover .trending-card__img {
    transform: scale(1.04);
  }

  .trending-card__wishlist {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 5;
    width: 32px;
    height: 32px;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(4px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    color: var(--ink, #0A0A0A);
    transition: all 0.25s ease;
  }

  .trending-card__wishlist:hover {
    background: #FFFFFF;
    transform: scale(1.1);
  }

  .trending-card__wishlist.active {
    color: var(--accent, #E10600);
  }

  /* Info */
  .trending-card__info {
    padding-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .trending-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .trending-card__name {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.35;
    color: var(--ink, #0A0A0A);
    margin: 0;
  }

  .trending-card__add {
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1;
    color: var(--ink, #0A0A0A);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0 0.25rem;
    transition: color 0.2s, transform 0.2s;
  }

  .trending-card__add:hover {
    color: var(--accent, #E10600);
    transform: scale(1.2);
  }

  .trending-card__price {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink, #0A0A0A);
    margin: 0;
  }

  .trending-card__swatches {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 0.25rem;
  }

  .trending-card__swatch {
    width: 8px;
    height: 8px;
    border-radius: 1px;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .trending-card__swatch-more {
    font-size: 0.625rem;
    color: var(--muted, #6B6B6B);
    margin-left: 2px;
  }

  @media (max-width: 1024px) {
    .trending__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .trending__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.875rem;
    }
  }
</style>

