---
// src/components/Testimonial.astro
// PRESS & EDITORIAL RECOGNITION — Formerly "Critical Acclaim"
// Clear, prestigious editorial press reviews with publication accolades & quote badges.

const pressReviews = [
  {
    quote: "A shirt that earns its permanent place in every wardrobe. No compromises.",
    outlet: "Wallpaper* Magazine",
    tag: "DESIGN EXCELLENCE",
    year: "2026",
  },
  {
    quote: "The quiet triumph of modern British tailoring — shirts cut with total clarity.",
    outlet: "Vogue International",
    tag: "STYLE HONOURS",
    year: "2026",
  },
  {
    quote: "The definitive gold standard of the oxford button-down. Worn for decades.",
    outlet: "GQ Style Report",
    tag: "ESSENTIAL BUY",
    year: "2026",
  },
];

const pressLogos = [
  'VOGUE',
  'GQ',
  'WALLPAPER*',
  'MONOCLE',
  'HYPEBEAST',
  'BUSINESS OF FASHION',
];
---

<section class="press-section section" id="press" aria-label="Press reviews and editorial recognition">

  <!-- Atmospheric Background Image with Vignette -->
  <div class="press__bg" aria-hidden="true" data-parallax="6">
    <picture>
      <source srcset="/images/press/strip.avif" type="image/avif" />
      <source srcset="/images/press/strip.webp" type="image/webp" />
      <img
        src="/images/press/strip.webp"
        alt="Merazo tailoring atelier editorial"
        width="2560"
        height="1097"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="press__overlay" aria-hidden="true"></div>
  </div>

  <div class="container press__content">

    <!-- Section Header: Clear, editorial & prestigious -->
    <div class="section-header">
      <p class="text-mono press__mono-tag">10 / 11 · PRESS & REVIEWS</p>
      <div data-reveal-heading>
        <h1 class="press__h2 display-grotesk">
          <span class="mask" style="display:block;">
            <span class="mask-inner">PRAISED BY THE</span>
          </span>
          <span class="mask" style="display:block;">
            <span class="mask-inner text-accent">PRESS.</span>
          </span>
        </h1>
      </div>
      <p class="press__subhead">
        Independent acclaim from the world’s leading design and fashion publications.
      </p>
    </div>

    <!-- Editorial Reviews Grid -->
    <div class="press__grid">
      {pressReviews.map((rev, idx) => (
        <article class={`press__card ${idx === 0 ? 'press__card--featured' : ''}`}>
          <div class="press__card-header">
            <span class="press__outlet text-display">{rev.outlet}</span>
            <span class="press__badge text-mono">{rev.tag}</span>
          </div>

          <blockquote class="press__quote-wrap">
            <p class="press__quote">
              “{rev.quote}”
            </p>
          </blockquote>

          <div class="press__card-footer text-mono">
            <span>EDITORIAL REVIEW · {rev.year}</span>
          </div>
        </article>
      ))}
    </div>

    <!-- Press Logos Strip -->
    <div class="press-logos" aria-label="Featured publications">
      {pressLogos.map((name) => (
        <span class="press-logo text-mono" aria-label={name}>{name}</span>
      ))}
    </div>

  </div>
</section>

<style>
  .press-section {
    position: relative;
    padding-block: clamp(6rem, 12vw, 11rem);
    color: var(--white, #FFFFFF);
    overflow: hidden;
    background: var(--ink, #0A0A0A);
  }

  .press__bg {
    position: absolute;
    inset: -5% 0;
    width: 100%;
    height: 110%;
    pointer-events: none;
  }

  .press__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.35) contrast(1.15);
  }

  .press__overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(10, 10, 10, 0.5) 0%, rgba(10, 10, 10, 0.9) 100%),
                linear-gradient(to bottom, var(--ink, #0A0A0A) 0%, transparent 25%, transparent 75%, var(--ink, #0A0A0A) 100%);
  }

  .press__content {
    position: relative;
    z-index: 5;
  }

  .press__mono-tag {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 0.75rem;
  }

  .press__h2 {
    font-family: var(--font-grotesk, "Inter Tight", "Helvetica Neue", Arial, sans-serif);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    line-height: 0.85;
    font-kerning: normal;
    color: #fff;
    margin: 0;
  }

  .press__subhead {
    margin-top: 1rem;
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    color: rgba(255, 255, 255, 0.75);
    max-width: 48ch;
    line-height: 1.6;
  }

  /* Reviews Grid */
  .press__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 2.5vw, 2.5rem);
    margin-top: clamp(3rem, 6vh, 5rem);
    margin-bottom: clamp(3.5rem, 7vh, 6rem);
  }

  .press__card {
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.35s ease;
  }

  .press__card:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-4px);
  }

  .press__card--featured {
    border-color: rgba(225, 6, 0, 0.4);
    background: rgba(225, 6, 0, 0.05);
  }

  .press__card--featured:hover {
    border-color: var(--accent, #E10600);
  }

  .press__card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .press__outlet {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--white, #FFFFFF);
  }

  .press__badge {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--accent, #E10600);
    padding: 0.2rem 0.5rem;
    background: rgba(225, 6, 0, 0.15);
    border: 1px solid rgba(225, 6, 0, 0.35);
    border-radius: 2px;
  }

  .press__quote-wrap {
    margin: 1.75rem 0;
  }

  .press__quote {
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    font-weight: 400;
  }

  .press__card-footer {
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.5);
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Logos Strip */
  .press-logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .press-logo {
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.3s ease;
  }

  .press-logo:hover {
    color: var(--white, #FFFFFF);
  }

  @media (max-width: 900px) {
    .press__grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
