---
// src/components/Nav.astro
// Clean 3-column navigation:
// Transparent at top, adapts color to active slide (light/dark), turns solid white after 24px scroll.
// 4 inline-SVG icons, accessible mobile overlay menu, smart scroll direction handling.
---

<!-- 1px Sentinel for IntersectionObserver scroll detection -->
<div id="nav-scroll-sentinel" aria-hidden="true" style="position:absolute;top:0;left:0;width:1px;height:24px;pointer-events:none;"></div>

<!-- Soft Top Scrim for dark slides at y=0 -->
<div id="nav-top-scrim" aria-hidden="true"></div>

<!-- Main Fixed Navigation Bar -->
<header id="site-nav" class="nav theme-dark" role="banner" aria-label="Main navigation">
  <div class="nav__container">

    <!-- Column 1: Hamburger + MENU label -->
    <div class="nav__col-left">
      <button
        id="nav-hamburger-btn"
        class="nav__hamburger-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="nav-menu-overlay"
      >
        <span class="hamburger-icon" aria-hidden="true">
          <span class="hamburger-line top"></span>
          <span class="hamburger-line bottom"></span>
        </span>
        <span class="hamburger-label text-mono">MENU</span>
      </button>
    </div>

    <!-- Column 2: MERAZO Wordmark -->
    <div class="nav__col-center">
      <a href="/" class="nav__wordmark" aria-label="Merazo — Home">
        MERAZO
      </a>
    </div>

    <!-- Column 3: 4 Line Icons (Search, Wishlist, Bag, Account) -->
    <div class="nav__col-right">
      <!-- Search Icon -->
      <button class="nav__icon-btn" type="button" aria-label="Search collection">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </button>

      <!-- Wishlist / Heart (Hidden on mobile) -->
      <a href="#collection" class="nav__icon-btn nav__icon-btn--desktop" aria-label="View wishlist">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </a>

      <!-- Bag Icon with '0' Count Badge -->
      <a href="#collection" class="nav__icon-btn nav__bag-btn" aria-label="Shopping bag, 0 items">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="nav__bag-badge text-mono" aria-hidden="true">0</span>
      </a>

      <!-- Account Icon (Hidden on mobile) -->
      <button class="nav__icon-btn nav__icon-btn--desktop" type="button" aria-label="Account">
        <svg class="nav__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </button>
    </div>

  </div>
</header>

<!-- Full-Screen Modal Navigation Menu Overlay -->
<div
  id="nav-menu-overlay"
  class="nav-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation directory"
  aria-hidden="true"
>
  <div class="nav-menu__header">
    <span class="text-mono" style="font-size:0.75rem;letter-spacing:0.18em;color:rgba(255,255,255,0.45);">MERAZO HOUSE</span>
    <button id="nav-menu-close-btn" class="nav-menu__close-btn" aria-label="Close menu">
      <span class="nav-menu__close-text text-mono">CLOSE</span>
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="nav-menu__inner">
    <nav class="nav-menu__nav" aria-label="Expanded site links">
      <ul class="nav-menu__list">
        {[
          { label: 'MEN', href: '#collection' },
          { label: 'WOMEN', href: '#collection' },
          { label: 'SHIRTS', href: '#showcase' },
          { label: 'CRAFT', href: '#craft' },
          { label: 'JOURNAL', href: '#press' },
          { label: 'STORES', href: '#contact' },
        ].map((item, i) => (
          <li class="nav-menu__item">
            <a href={item.href} class="nav-menu__link">
              <span class="menu-link-mask">
                <span class="menu-link-inner">
                  <span class="menu-link-num text-mono">0{i + 1}</span>
                  {item.label}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Bottom Footer Meta in Menu -->
    <div class="nav-menu__footer">
      <div>
        <p class="text-mono" style="font-size:0.6875rem;letter-spacing:0.08em;color:rgba(255,255,255,0.45);text-transform:uppercase;margin-bottom:0.5rem;">
          Merazo Apparels 
        </p>
        <div style="display:flex;gap:1.5rem;">
          <a href="mailto:hello@merazo.com" style="color:var(--white);font-family:var(--font-mono);font-size:0.75rem;">hello@merazo.com</a>
          <a href="tel:+442079460000" style="color:var(--white);font-family:var(--font-mono);font-size:0.75rem;">+44 (0) 20 7946 0000</a>
        </div>
      </div>
      <p class="text-mono" style="font-size:0.6875rem;color:rgba(255,255,255,0.3);letter-spacing:0.08em;">
        © {new Date().getFullYear()} MERAZO
      </p>
    </div>
  </div>
</div>

<style>
  /* Top soft scrim */
  #nav-top-scrim {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(rgba(0, 0, 0, 0.28), transparent);
    pointer-events: none;
    z-index: 899;
    transition: opacity 0.4s ease;
  }

  /* Main Nav Header */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    z-index: 900;
    background: transparent;
    transition: background-color 0.35s ease, height 0.35s ease, transform 0.35s ease, border-color 0.35s ease;
    border-bottom: 1px solid transparent;
  }

  .nav.nav-hidden {
    transform: translateY(-100%);
  }

  /* Scrolled State: Solid White Background, Ink Text */
  .nav.is-scrolled {
    background: #FFFFFF !important;
    height: 56px !important;
    border-bottom: 1px solid rgba(10, 10, 10, 0.08) !important;
  }

  .nav__container {
    height: 100%;
    padding-inline: clamp(16px, 3vw, 40px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  /* Column 1: Hamburger */
  .nav__col-left {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .nav__hamburger-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem 0;
    color: currentColor;
  }

  .hamburger-icon {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
  }

  .hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s ease, background-color 0.4s ease;
  }

  .hamburger-label {
    display: inline-block;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    font-weight: 500;
    margin-left: 0.25rem;
    color: currentColor;
    transition: color 0.4s ease;
  }

  @media (max-width: 768px) {
    .nav {
      height: 56px;
    }
    .hamburger-label {
      display: none;
    }
  }

  /* Column 2: Wordmark */
  .nav__col-center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav__wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 150%;
    font-variation-settings: "wdth" 150, "wght" 900;
    font-size: 1.125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: currentColor;
    text-decoration: none;
    transition: color 0.4s ease;
  }

  /* Column 3: Icons */
  .nav__col-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(0.75rem, 1.8vw, 1.5rem);
  }

  .nav__icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: currentColor;
    cursor: pointer;
    padding: 0.25rem;
    transition: color 0.4s ease, transform 0.2s ease;
  }

  .nav__icon-btn:hover {
    transform: scale(1.08);
  }

  .nav__icon {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .nav__bag-btn {
    position: relative;
  }

  .nav__bag-badge {
    position: absolute;
    top: -2px;
    right: -6px;
    font-size: 0.625rem;
    line-height: 1;
    background: var(--accent);
    color: var(--white);
    padding: 2px 4px;
    border-radius: 9999px;
  }

  @media (max-width: 768px) {
    .nav__icon-btn--desktop {
      display: none !important;
    }
  }

  /* Color Adaptations: Theme Light (on bright slides) vs Theme Dark (on dark slides) */
  .nav.theme-dark {
    color: var(--white);
  }

  .nav.theme-light {
    color: var(--ink);
  }

  .nav.is-scrolled {
    color: var(--ink) !important;
  }

  /* Modal Menu Overlay */
  .nav-menu {
    position: fixed;
    inset: 0;
    background: var(--ink, #0A0A0A);
    z-index: 950;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(2rem, 5vh, 4rem) clamp(1.5rem, 4vw, 4rem);
    transform: translateY(-100%);
    pointer-events: none;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-menu.is-open {
    transform: translateY(0);
    pointer-events: all;
  }

  .nav-menu__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    position: relative;
    z-index: 10;
  }

  .nav-menu__close-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
    padding: 0.45rem 1.1rem;
    color: var(--white);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-menu__close-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: scale(1.04);
  }

  .nav-menu__close-text {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    font-family: var(--font-mono);
  }

  .nav-menu__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-top: clamp(2rem, 5vh, 3.5rem);
    padding-bottom: 2rem;
  }

  .nav-menu__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(0.75rem, 2vh, 1.5rem);
    margin: 0;
    padding: 0;
  }

  .nav-menu__item {
    overflow: hidden;
  }

  .nav-menu__link {
    display: inline-block;
    text-decoration: none;
    color: var(--white, #FFFFFF);
    font-family: var(--font-grotesk, "Inter Tight", "Helvetica Neue", Arial, sans-serif);
    font-weight: 800;
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    font-kerning: normal;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }

  .nav-menu__link:hover {
    color: var(--accent, #E10600);
  }

  .menu-link-mask {
    display: block;
    overflow: hidden;
  }

  .menu-link-inner {
    display: flex;
    align-items: center;
    color: var(--white, #FFFFFF) !important;
    transform: translateY(0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .menu-link-num {
    font-size: 0.875rem;
    color: var(--accent, #E10600);
    margin-right: 1.25rem;
    font-family: var(--font-mono);
  }

  .nav-menu__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
  }
</style>
